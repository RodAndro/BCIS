# pnpm 10+ blocks dependency build scripts unless allowlisted.
# The allowlist lives in root package.json under "pnpm.onlyBuiltDependencies"
# because it is project policy and should be reviewed like any other config.
strict-peer-dependencies=false

# Keep the store on the same drive as the repo so Electron's postinstall
# does not cross drives when creating its hard links.
node-linker=isolated
