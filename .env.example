# ---------------------------------------------------------------------------
# BCIS Subscription Billing and Collection System
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
#
# Only the settings Phase 1 actually reads are listed here. Keys for sessions,
# attachments, and backup are added by the phase that starts using them, so
# this file never documents configuration that nothing consumes.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- API -----------------------------------------------------------------
# Bind to 127.0.0.1 for single-machine development.
# For the Phase 9 three-PC LAN deployment this becomes the API host's LAN
# address (for example 192.168.1.10) with TLS in front of it.
API_HOST=127.0.0.1
API_PORT=4000

# Base URL the Electron main process uses to reach the API.
BCIS_API_URL=http://127.0.0.1:4000

# --- Database ------------------------------------------------------------
# Local PostgreSQL 17, run from the portable binaries by scripts/pg.ps1.
# Port 5433 avoids colliding with any PostgreSQL service already installed.
DATABASE_URL=postgresql://bcis:bcis_dev_password@127.0.0.1:5433/bcis

# Integration tests create and destroy every object in this database.
# It must never point at development data.
TEST_DATABASE_URL=postgresql://bcis:bcis_dev_password@127.0.0.1:5433/bcis_test

# Log every SQL statement. Never enable in production: statement logs can
# contain payment reference numbers and subscriber names.
DB_LOG_QUERIES=false
