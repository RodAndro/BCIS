# ---------------------------------------------------------------------------
# BCIS Subscription Billing and Collection System
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
#
# Only the settings Phase 1 actually reads are listed here. Keys for sessions,
# attachments and backup are configured below for the recovery workflow.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- API -----------------------------------------------------------------
# Bind to 127.0.0.1 for single-machine development.
# For the Phase 9 three-PC LAN deployment this becomes the API host's LAN
# address (for example 192.168.1.10) with TLS in front of it.
API_HOST=127.0.0.1
API_PORT=4000

# Base URL the Electron main process uses to reach the API.
BCIS_API_URL=http://127.0.0.1:4000

# --- Database ------------------------------------------------------------
# Local PostgreSQL 17, run from the portable binaries by scripts/pg.ps1.
# Port 5433 avoids colliding with any PostgreSQL service already installed.
DATABASE_URL=postgresql://bcis:bcis_dev_password@127.0.0.1:5433/bcis

# Integration tests create and destroy every object in this database.
# It must never point at development data.
TEST_DATABASE_URL=postgresql://bcis:bcis_dev_password@127.0.0.1:5433/bcis_test

# Log every SQL statement. Never enable in production: statement logs can
# contain payment reference numbers and subscriber names.
DB_LOG_QUERIES=false

# --- Sessions and lockout (Phase 2) --------------------------------------
# How long a session stays valid. One long shift is 12 hours; a session that
# outlives the shift is a workstation left signed in overnight.
SESSION_TTL_HOURS=12

# Consecutive failed sign-ins before the account is locked.
MAX_FAILED_LOGIN_ATTEMPTS=5

# How long an account stays locked after too many failed sign-ins.
ACCOUNT_LOCK_MINUTES=15

# --- Recovery (Phase 9) --------------------------------------------------
# Paths are resolved by the API host. Keep backups outside the application
# bundle and on a disk included in the operator's backup rotation.
BACKUP_ROOT=data/backups
PROOF_STORAGE_ROOT=data/proofs
POSTGRES_BIN_DIR=.runtime/pgsql/bin

# --- Development seed (Phase 2) ------------------------------------------
# Used only by `pnpm db:seed`, which refuses to run with NODE_ENV=production.
# The defaults are documented in the README. Override them to get a different
# local password; never reuse a real password here.
SEED_ADMIN_PASSWORD=Admin@BCIS2026
SEED_CASHIER_PASSWORD=Cashier@BCIS2026
SEED_AUDITOR_PASSWORD=Auditor@BCIS2026
SEED_ADMINISTRATOR_PASSWORD=Admin2@BCIS2026
SEED_SUPERVISOR_PASSWORD=Supervisor@BCIS2026
SEED_TECHNICIAN_PASSWORD=Technician@BCIS2026
